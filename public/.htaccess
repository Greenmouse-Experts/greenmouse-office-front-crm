<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let Vite's generated assets and other real files load normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Forward client-side routes to the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>
